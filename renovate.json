{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Cedar canaries are published for every merge to main",
      "matchPackageNames": ["@cedarjs/project-config"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "The peer ranges say which Cedar and Vite versions apps can use, and are changed by hand",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}
